  <subtitle>A Simple and Card UI Design theme for Hexo</subtitle>
  <title>Butterfly</title>
  <updated>2025-12-10T00:00:00.000Z</updated>
  <entry>
    <author>
      <name>Jerry</name>
    </author>
    <category term="Docs" scheme="https://butterfly.js.org/categories/Docs/"/>
    <category term="Tutorial" scheme="https://butterfly.js.org/tags/Tutorial/"/>
    <category term="Hexo" scheme="https://butterfly.js.org/tags/Hexo/"/>
